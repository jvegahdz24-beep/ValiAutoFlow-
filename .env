# ============================================================
# ValiAutoFlow — Development Environment
# ============================================================
# For production, replace with Supabase PostgreSQL URLs.

# DATABASE — SQLite for local development
DATABASE_URL="file:./db/custom.db"
DIRECT_URL="file:./db/custom.db"

# NextAuth Configuration
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=valiautoflow-dev-secret-change-in-production-2024
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional - leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI (required for cognitive engine)
OPENAI_API_KEY=

# WhatsApp Cloud API (optional)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=

# Redis for BullMQ (optional - falls back to sync execution)
REDIS_URL=
