# ============================================================
# ValiAutoFlow - Environment Variables
# ============================================================
# Copy this file as .env.local and fill in the values.
# NEVER commit real secrets to git.
# ============================================================

# ── DATABASE (Supabase PostgreSQL) ──────────────────────────
# Pooled connection (via PgBouncer) - used by app at runtime
DATABASE_URL=postgresql://postgres.XXXX:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (no pooler) - used by Prisma migrations
DIRECT_URL=postgresql://postgres.XXXX:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── AUTH (NextAuth) ────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-random-secret
# Your production URL (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# ── GOOGLE OAUTH (Optional - for Google Login) ─────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── WHATSAPP CLOUD API (Meta Business) ─────────────────────
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WABA_ID=your-waba-id

# ── TELEGRAM BOT ───────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ── AI / LLM ──────────────────────────────────────────────
# OpenAI API key for JHON agent, MARK agent, and cognitive engine
OPENAI_API_KEY=sk-...

# GLM API key (z-ai-web-dev-sdk)
GLM_API_KEY=

# ── REDIS / BULLMQ (Job Queue) ────────────────────────────
# Redis connection for campaign queue and background jobs
# Use Upstash Redis for Vercel: https://upstash.com
REDIS_URL=redis://default:YOUR_PASSWORD@your-redis-host:6379

# ── GOOGLE CALENDAR (Optional) ────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ============================================================
# DEVELOPMENT ONLY (do not set in production)
# ============================================================
# For local SQLite development, uncomment:
# DATABASE_URL=file:./dev.db
