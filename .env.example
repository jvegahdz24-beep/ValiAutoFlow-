# ============================================================
# ValiAutoFlow - Environment Variables
# ============================================================
# Copy this file as .env and fill in the values.
# NEVER commit real secrets to git.
# ============================================================

# ── DATABASE (Supabase PostgreSQL) ──────────────────────────
# Pooled connection (via PgBouncer) - used by app at runtime
DATABASE_URL=postgresql://postgres.XXXX:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Direct connection - used by Prisma migrations
# On Vercel: use the db.XXXX.supabase.co:5432 format
# Locally (if IPv6-unreachable): use pooler session mode port 5432
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.XXXX.supabase.co:5432/postgres

# ── SUPABASE (Client SDK — Auth/Storage/Realtime) ───────────
# Single Supabase project for DB + Auth + Storage + Realtime
NEXT_PUBLIC_SUPABASE_URL=https://XXXX.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ── AUTH (NextAuth) ────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-random-secret
# Your production URL (no trailing slash)
NEXTAUTH_URL=http://localhost:3000
# Internal API key for server-to-server calls (webhooks → engine)
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=replace-with-random-internal-key

# ── GOOGLE OAUTH (Optional - for Google Login) ─────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── WHATSAPP CLOUD API (Meta Business) ─────────────────────
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WABA_ID=your-waba-id
# Meta App Secret for HMAC webhook signature verification (CRITICAL for production)
WHATSAPP_APP_SECRET=your-meta-app-secret

# ── TELEGRAM BOT ───────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ── AI / LLM ──────────────────────────────────────────────
# OpenAI API key for JHON agent, MARK agent, and cognitive engine
OPENAI_API_KEY=sk-...
# GLM API key (z-ai-web-dev-sdk)
GLM_API_KEY=

# ── REDIS / BULLMQ (Job Queue) ────────────────────────────
# Redis connection for campaign queue and background jobs
# Use Upstash Redis for Vercel: https://upstash.com
REDIS_URL=rediss://default:YOUR_PASSWORD@us1-xxx.upstash.io:6379

# ── GOOGLE CALENDAR (Optional) ────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
